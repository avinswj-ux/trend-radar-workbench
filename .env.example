DATABASE_URL="postgresql://postgres:postgres@localhost:5434/trend_radar?schema=public"
REDIS_URL="redis://localhost:6381"
# Primary text analysis provider.
TEXT_ANALYSIS_PROVIDER="deepseek"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-v4-flash-0731"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Ark is the text-analysis fallback and the future TTS provider.
ARK_API_KEY=""
ARK_MODEL="doubao-seed-2-0-lite-260215"
ARK_IMAGE_MODEL="doubao-seedream-5-0-260128"
# Override only when using another Ark region or compatible endpoint.
ARK_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"

# Visual understanding: default is a local MiniCPM-V 4.6 instance via Ollama.
VISION_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_VISION_MODEL="openbmb/minicpm-v4.6"
# Optional remote visual and image fallback.
DASHSCOPE_API_KEY=""
DASHSCOPE_BASE_URL=""
DASHSCOPE_VISION_MODEL=""
DASHSCOPE_IMAGE_MODEL="wan2.7-image"
# Optional: raises the GitHub Search API quota for the GitHub source adapter.
GITHUB_TOKEN=""
# YouTube Data API v3 key. Restrict it to this API in Google Cloud Console.
YOUTUBE_API_KEY=""

# Volcengine Doubao TTS. Official 2.0 voices use seed-tts-2.0 + APP ID.
# Cloned voices (S_...) use seed-icl-2.0 over the bidirectional socket.
VOLC_TTS_API_KEY=""
VOLC_TTS_APP_ID=""
VOLC_TTS_SPEAKER="zh_male_dayi_uranus_bigtts"
VOLC_TTS_RESOURCE_ID="seed-tts-2.0"
AVIN_TTS_SPEECH_RATE="28"
AVIN_TTS_LOUDNESS_RATE="12"

# Local Avin avatar material folder. Existing source filenames still use the legacy Fishy prefix.
FISHY_ASSETS_DIR="/absolute/path/to/Avin口播素材包"
